{
  "@context": {
    "@version": 1.1,
    "nfg": "https://nfg.ngraph.jp/schema/v0.3/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "SeafoodRestaurant": "nfg:SeafoodRestaurant",
    "CocktailBar": "nfg:CocktailBar",
    "KappoRestaurant": "nfg:KappoRestaurant",
    "KaisekiRestaurant": "nfg:KaisekiRestaurant",
    "Dish": "nfg:Dish",
    "Ingredient": "nfg:Ingredient",

    "vadCertified": { "@id": "nfg:vadCertified", "@type": "xsd:boolean" },
    "vadSource": { "@id": "nfg:vadSource" },
    "confidenceScore": { "@id": "nfg:confidenceScore", "@type": "xsd:decimal" },

    "culturalContext": { "@id": "nfg:culturalContext" },
    "cookingMethods": { "@id": "nfg:cookingMethods", "@container": "@set" },
    "dishCategory": { "@id": "nfg:dishCategory" },
    "mainIngredients": { "@id": "nfg:mainIngredients", "@container": "@set" },
    "courseFlow": { "@id": "nfg:courseFlow", "@container": "@list" },

    "provenance": { "@id": "nfg:provenance" },
    "scientificName": { "@id": "nfg:scientificName" },
    "habitat": { "@id": "nfg:habitat" },
    "certificationTag": { "@id": "nfg:certificationTag" },
    "seasonStart": { "@id": "nfg:seasonStart" },
    "seasonEnd": { "@id": "nfg:seasonEnd" }
  }
}
